<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="order_processing" name="Order Processing" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>Flow_start_validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_validate" sourceRef="StartEvent_1" targetRef="Task_ValidateOrder" />
    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_validate</bpmn:incoming>
      <bpmn:outgoing>Flow_validate_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_validate_gw" sourceRef="Task_ValidateOrder" targetRef="GW_OrderValid" />
    <bpmn:exclusiveGateway id="GW_OrderValid" name="Order Valid?">
      <bpmn:incoming>Flow_validate_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_valid_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_valid_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_valid_yes" sourceRef="GW_OrderValid" targetRef="GW_ParallelSplit">
      <bpmn:conditionExpression>=orderValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_valid_no" sourceRef="GW_OrderValid" targetRef="Event_Compensate">
      <bpmn:conditionExpression>=not(orderValid)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:parallelGateway id="GW_ParallelSplit" name="Parallel Split">
      <bpmn:incoming>Flow_valid_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_to_payment</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_inventory</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_to_payment" sourceRef="GW_ParallelSplit" targetRef="Task_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_to_inventory" sourceRef="GW_ParallelSplit" targetRef="Task_CheckInventory" />
    <bpmn:serviceTask id="Task_ProcessPayment" name="Process Payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_payment</bpmn:incoming>
      <bpmn:outgoing>Flow_payment_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckInventory" name="Check Inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-inventory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_inventory</bpmn:incoming>
      <bpmn:outgoing>Flow_inventory_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_payment_join" sourceRef="Task_ProcessPayment" targetRef="GW_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_inventory_join" sourceRef="Task_CheckInventory" targetRef="GW_ParallelJoin" />
    <bpmn:parallelGateway id="GW_ParallelJoin" name="Wait for Both">
      <bpmn:incoming>Flow_payment_join</bpmn:incoming>
      <bpmn:incoming>Flow_inventory_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_check</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_join_check" sourceRef="GW_ParallelJoin" targetRef="GW_CheckResults" />
    <bpmn:exclusiveGateway id="GW_CheckResults" name="Both OK?">
      <bpmn:incoming>Flow_join_check</bpmn:incoming>
      <bpmn:outgoing>Flow_success</bpmn:outgoing>
      <bpmn:outgoing>Flow_failure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_success" sourceRef="GW_CheckResults" targetRef="Task_ShipOrder">
      <bpmn:conditionExpression>=paymentSuccess and inventoryReserved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_failure" sourceRef="GW_CheckResults" targetRef="Event_Compensate">
      <bpmn:conditionExpression>=not(paymentSuccess) or not(inventoryReserved)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_ShipOrder" name="Ship Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ship-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_success</bpmn:incoming>
      <bpmn:outgoing>Flow_ship_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ship_end" sourceRef="Task_ShipOrder" targetRef="EndEvent_Success" />
    <bpmn:endEvent id="EndEvent_Success" name="Order Completed">
      <bpmn:incoming>Flow_ship_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="Event_Compensate" name="Compensate">
      <bpmn:incoming>Flow_failure</bpmn:incoming>
      <bpmn:incoming>Flow_valid_no</bpmn:incoming>
      <bpmn:outgoing>Flow_13jkfyy</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompDef_Throw" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndEvent_Failed" name="Order Failed">
      <bpmn:incoming>Flow_13jkfyy</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_RefundPayment" name="Refund Payment" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="refund-payment" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReleaseInventory" name="Release Inventory" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-inventory" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_CompPayment" attachedToRef="Task_ProcessPayment">
      <bpmn:compensateEventDefinition id="CompDef_Payment" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompInventory" attachedToRef="Task_CheckInventory">
      <bpmn:compensateEventDefinition id="CompDef_Inventory" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_13jkfyy" sourceRef="Event_Compensate" targetRef="EndEvent_Failed" />
    <bpmn:association id="Assoc_Payment" associationDirection="One" sourceRef="Boundary_CompPayment" targetRef="Task_RefundPayment" />
    <bpmn:association id="Assoc_Inventory" associationDirection="One" sourceRef="Boundary_CompInventory" targetRef="Task_ReleaseInventory" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="order_processing">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
