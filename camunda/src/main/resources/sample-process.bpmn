  <bpmn:process id="personal_loan_approval" name="Personal Loan Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0nnr7d3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0nnr7d3" sourceRef="StartEvent_1" targetRef="Activity_0o6lyw1" />
    <bpmn:userTask id="Activity_0o6lyw1" name="Loan Application">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_0l7pypq" />
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="completing" type="save-person-info" />
        </zeebe:taskListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0nnr7d3</bpmn:incoming>
      <bpmn:outgoing>Flow_0oggl3f</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_17a1ydj" name="Wait for 24h" cancelActivity="false" attachedToRef="Activity_0o6lyw1">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &#34;Loan Application&#34;" target="taskName" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1nu9p45</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1al567k">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1nu9p45" sourceRef="Event_17a1ydj" targetRef="Activity_0ua2mov" />
    <bpmn:sequenceFlow id="Flow_0oggl3f" sourceRef="Activity_0o6lyw1" targetRef="Activity_022sgg3" />
    <bpmn:businessRuleTask id="Activity_022sgg3" name="Eligibility Check">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_Eligibility" resultVariable="eligibility" />
        <zeebe:ioMapping>
          <zeebe:input source="=age" target="age" />
          <zeebe:output source="=eligibility" target="eligibility" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0oggl3f</bpmn:incoming>
      <bpmn:outgoing>Flow_0fol1zg</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0fol1zg" sourceRef="Activity_022sgg3" targetRef="Gateway_1dv7j9o" />
    <bpmn:exclusiveGateway id="Gateway_1dv7j9o" name="Eligible?">
      <bpmn:incoming>Flow_0fol1zg</bpmn:incoming>
      <bpmn:outgoing>Flow_06pjnml</bpmn:outgoing>
      <bpmn:outgoing>Flow_1bg4o8q</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1bg4o8q" name="Not Eligible" sourceRef="Gateway_1dv7j9o" targetRef="Event_1bp6sz3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibility = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1bp6sz3" name="Reject">
      <bpmn:incoming>Flow_1bg4o8q</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_06pjnml" name="Eligible" sourceRef="Gateway_1dv7j9o" targetRef="Gateway_196pccv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibility = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:parallelGateway id="Gateway_196pccv" name="Split">
      <bpmn:incoming>Flow_06pjnml</bpmn:incoming>
      <bpmn:outgoing>Flow_09qlyde</bpmn:outgoing>
      <bpmn:outgoing>Flow_0g00kwc</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_09qlyde" sourceRef="Gateway_196pccv" targetRef="SubProcess_ManagerReview" />
    <bpmn:subProcess id="SubProcess_ManagerReview" name="Manager Review">
      <bpmn:incoming>Flow_09qlyde</bpmn:incoming>
      <bpmn:outgoing>Flow_SubProcess_to_Merge</bpmn:outgoing>
      <bpmn:startEvent id="SubStart_1">
        <bpmn:outgoing>Flow_sub_start_to_task</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_sub_start_to_task" sourceRef="SubStart_1" targetRef="Activity_1las0zj" />
      <bpmn:userTask id="Activity_1las0zj" name="Manager Review">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="Form_manager_review" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_sub_start_to_task</bpmn:incoming>
        <bpmn:outgoing>Flow_task_to_sub_end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_task_to_sub_end" sourceRef="Activity_1las0zj" targetRef="SubEnd_1" />
      <bpmn:endEvent id="SubEnd_1" name="Reviewed">
        <bpmn:incoming>Flow_task_to_sub_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="SubTimer_1" name="No response&#10;in 2 min" attachedToRef="Activity_1las0zj">
        <bpmn:extensionElements />
        <bpmn:outgoing>Flow_timer_to_esc_end</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerDef_sub">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_timer_to_esc_end" sourceRef="SubTimer_1" targetRef="SubEscEnd_1" />
      <bpmn:endEvent id="SubEscEnd_1" name="Escalated">
        <bpmn:incoming>Flow_timer_to_esc_end</bpmn:incoming>
        <bpmn:escalationEventDefinition id="EscDef_sub" escalationRef="Escalation_ManagerEscalation" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="EscBoundary_1" name="Manager Escalated" attachedToRef="SubProcess_ManagerReview">
      <bpmn:outgoing>Flow_esc_to_notify</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscBoundaryDef_1" escalationRef="Escalation_ManagerEscalation" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_esc_to_notify" sourceRef="EscBoundary_1" targetRef="Activity_notifySenior" />
    <bpmn:serviceTask id="Activity_notifySenior" name="Notify Senior Manager">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-senior-manager" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_esc_to_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_SubProcess_to_Merge" sourceRef="SubProcess_ManagerReview" targetRef="Gateway_MergeManager" />
    <bpmn:sequenceFlow id="Flow_notify_to_merge" sourceRef="Activity_notifySenior" targetRef="Gateway_MergeManager" />
    <bpmn:exclusiveGateway id="Gateway_MergeManager" name="Merge">
      <bpmn:incoming>Flow_SubProcess_to_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_notify_to_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_to_andJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_merge_to_andJoin" sourceRef="Gateway_MergeManager" targetRef="Gateway_1gnzdgq" />
    <bpmn:sequenceFlow id="Flow_0g00kwc" sourceRef="Gateway_196pccv" targetRef="Activity_09ai5vf" />
    <bpmn:serviceTask id="Activity_09ai5vf" name="Background Check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="backgroundCheck" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0g00kwc</bpmn:incoming>
      <bpmn:outgoing>Flow_15nxo3v</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_15nxo3v" sourceRef="Activity_09ai5vf" targetRef="Gateway_1gnzdgq" />
    <bpmn:parallelGateway id="Gateway_1gnzdgq" name="Join">
      <bpmn:incoming>Flow_merge_to_andJoin</bpmn:incoming>
      <bpmn:incoming>Flow_15nxo3v</bpmn:incoming>
      <bpmn:outgoing>Flow_1udcvau</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1udcvau" sourceRef="Gateway_1gnzdgq" targetRef="Event_0bc1dy1" />
    <bpmn:endEvent id="Event_0bc1dy1" name="End">
      <bpmn:incoming>Flow_1udcvau</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_0ua2mov" name="Reminder Email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-manager-reminder" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1nu9p45</bpmn:incoming>
      <bpmn:outgoing>Flow_1b72fra</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1tc0wrf" name="Notification Sent">
      <bpmn:incoming>Flow_1b72fra</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1b72fra" sourceRef="Activity_0ua2mov" targetRef="Event_1tc0wrf" />
  </bpmn:process>
