<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_10v6gas" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="personal_loan_approval" name="Personal Loan Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0nnr7d3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0nnr7d3" sourceRef="StartEvent_1" targetRef="Activity_0o6lyw1" />
    <bpmn:userTask id="Activity_0o6lyw1" name="Loan Application">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_0l7pypq" />
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="completing" type="save-person-info" />
        </zeebe:taskListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0nnr7d3</bpmn:incoming>
      <bpmn:outgoing>Flow_0oggl3f</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0oggl3f" sourceRef="Activity_0o6lyw1" targetRef="Activity_022sgg3" />
    <bpmn:businessRuleTask id="Activity_022sgg3" name="Eligibility Check">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_Eligibility" resultVariable="eligibility" />
        <zeebe:ioMapping>
          <zeebe:input source="=age" target="age" />
          <zeebe:output source="=eligibility" target="eligibility" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0oggl3f</bpmn:incoming>
      <bpmn:outgoing>Flow_0fol1zg</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0fol1zg" sourceRef="Activity_022sgg3" targetRef="Gateway_1dv7j9o" />
    <bpmn:endEvent id="Event_1bp6sz3" name="Reject">
      <bpmn:incoming>Flow_1bg4o8q</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1bg4o8q" name="Not Eligible" sourceRef="Gateway_1dv7j9o" targetRef="Event_1bp6sz3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibility = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06pjnml" name="Eligible" sourceRef="Gateway_1dv7j9o" targetRef="Gateway_196pccv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibility = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:parallelGateway id="Gateway_196pccv">
      <bpmn:incoming>Flow_06pjnml</bpmn:incoming>
      <bpmn:outgoing>Flow_09qlyde</bpmn:outgoing>
      <bpmn:outgoing>Flow_0g00kwc</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_09qlyde" sourceRef="Gateway_196pccv" targetRef="Activity_1las0zj" />
    <bpmn:sequenceFlow id="Flow_0g00kwc" sourceRef="Gateway_196pccv" targetRef="Activity_09ai5vf" />
    <bpmn:userTask id="Activity_1las0zj" name="Manager Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_manager_review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09qlyde</bpmn:incoming>
      <bpmn:outgoing>Flow_1w5i2vc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_09ai5vf" name="Background Check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="backgroundCheck" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0g00kwc</bpmn:incoming>
      <bpmn:outgoing>Flow_15nxo3v</bpmn:outgoing>
