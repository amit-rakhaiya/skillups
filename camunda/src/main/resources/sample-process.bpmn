    <bpmn:sequenceFlow id="Flow_1w5i2vc" sourceRef="Activity_1las0zj" targetRef="Gateway_1gnzdgq" />
    <bpmn:sequenceFlow id="Flow_15nxo3v" sourceRef="Activity_09ai5vf" targetRef="Gateway_1gnzdgq" />
    <bpmn:parallelGateway id="Gateway_1gnzdgq">
      <bpmn:incoming>Flow_1w5i2vc</bpmn:incoming>
      <bpmn:incoming>Flow_15nxo3v</bpmn:incoming>
      <bpmn:outgoing>Flow_1udcvau</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Event_0bc1dy1" name="End">
      <bpmn:incoming>Flow_1udcvau</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1udcvau" sourceRef="Gateway_1gnzdgq" targetRef="Event_0bc1dy1" />
    <bpmn:boundaryEvent id="Event_1q42umw" name="Wait for 60s" cancelActivity="false" attachedToRef="Activity_1las0zj">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &#34;Manager Review&#34;" target="taskName" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0gmdkou</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1wzzcse">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT60S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0gmdkou" sourceRef="Event_1q42umw" targetRef="Activity_0ua2mov" />
    <bpmn:serviceTask id="Activity_0ua2mov" name="Reminder Email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-manager-reminder" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0gmdkou</bpmn:incoming>
      <bpmn:incoming>Flow_1nu9p45</bpmn:incoming>
      <bpmn:outgoing>Flow_1b72fra</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_17a1ydj" name="Wait for 24h" cancelActivity="false" attachedToRef="Activity_0o6lyw1">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &#34;Loan Application&#34;" target="taskName" />
